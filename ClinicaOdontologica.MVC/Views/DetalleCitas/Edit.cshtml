            <div class="form-group">
                <label asp-for="idCita" class="control-label"></label>
                <input asp-for="idCita" class="form-control" />
                <span asp-validation-for="idCita" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="cita" class="control-label"></label>
                <input asp-for="cita" class="form-control" />
                <span asp-validation-for="cita" class="text-danger"></span>
