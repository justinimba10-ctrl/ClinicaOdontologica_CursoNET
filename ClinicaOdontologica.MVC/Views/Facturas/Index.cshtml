@model IEnumerable<ClinicaOdontologica.Modelos.Factura>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.fechaEmision)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.subtotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.impuestos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.total)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.estadoPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idCita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.cita)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.fechaEmision)
            </td>
            <td>
                @Html.DisplayFor(model => item.subtotal)
            </td>
            <td>
                @Html.DisplayFor(model => item.impuestos)
            </td>
            <td>
                @Html.DisplayFor(model => item.total)
            </td>
            <td>
                @Html.DisplayFor(model => item.estadoPago)
            </td>
            <td>
                @Html.DisplayFor(model => item.idCita)
            </td>
            <td>
                @Html.DisplayFor(model => item.cita)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idFactura">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idFactura">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idFactura">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
